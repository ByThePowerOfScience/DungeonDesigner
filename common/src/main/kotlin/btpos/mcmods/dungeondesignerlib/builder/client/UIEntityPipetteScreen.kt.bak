import net.minecraftforge.common.ForgeSpawnEggItem

class UIEntityPipetteScreen(pMenu: UIEntityPipetteMenu, pPlayerInventory: Inventory, pTitle: Component) : AbstractContainerScreen<UIEntityPipetteMenu>(pMenu, pPlayerInventory, pTitle) {
	override fun renderBg(pGuiGraphics: GuiGraphics, pPartialTick: Float, pMouseX: Int, pMouseY: Int) {
		TODO("Not yet implemented")
	}
}
// Realized that you can't pick-block an entity to get an egg with its NBT, so putting in a spawn egg won't work.

private const val EGG_SLOT_IDX = 0
private const val INV_SLOT_START = 1
private const val INV_SLOT_END = 28
private const val USE_ROW_SLOT_START = 28
private const val USE_ROW_SLOT_END = 37

class UIEntityPipetteMenu(
	pMenuType: MenuType<*>?,
	pContainerId: Int,
	pPlayerInventory: Inventory,
	val pipetteStack: ItemStack
) : AbstractContainerMenu(pMenuType, pContainerId) {
	
	init {
		addSlot(EggSlot(pipetteStack, 1, 50, 50))
		addPlayerInventory(pPlayerInventory)
	}
	
	/**
	 * @see net.minecraft.world.inventory.AbstractFurnaceMenu(net.minecraft.world.inventory.MenuType<?>, net.minecraft.world.item.crafting.RecipeType<? extends net.minecraft.world.item.crafting.AbstractCookingRecipe>, net.minecraft.world.inventory.RecipeBookType, int, net.minecraft.world.entity.player.Inventory, net.minecraft.world.Container, net.minecraft.world.inventory.ContainerData)
	 */
	fun addPlayerInventory(inventory: Inventory) {
		// Add hotbar
		for (i in 0..8) {
			this.addSlot(Slot(inventory, i, 8 + i * 18, 142))
		}
		// Add inventory
		for (row in 0..2) {
			for (i in 0..8) {
				this.addSlot(Slot(inventory, i + row * 9 + 9, 8 + i * 18, 84 + row * 18))
			}
		}
		
	}
	
	
	override fun quickMoveStack(pPlayer: Player, pIndex: Int): ItemStack {
		if (!slots[pIndex].hasItem())
			return ItemStack.EMPTY
		
		var outStack = ItemStack.EMPTY
		
		when (pIndex) {
			EGG_SLOT_IDX -> {
				outStack = slots[pIndex].item.copy()
				if (!moveItemStackTo(outStack, INV_SLOT_START, INV_SLOT_END, true)) {
					return ItemStack.EMPTY
				}
			}
			in INV_SLOT_START..USE_ROW_SLOT_END -> {
			
			}
		}
		
		return outStack
	}
	
	
	override fun stillValid(pPlayer: Player): Boolean {
		return pPlayer.mainHandItem == pipetteStack || pPlayer.offhandItem == pipetteStack
	}
}

class EggSlot(sourceStack: ItemStack, pSlot: Int, pX: Int, pY: Int)
	: SlotOptic<IEntityFightData>(
		object : IItemRepresentable<IEntityFightData> {
			override var value: IEntityFightData? = IEntityFightData.NbtAdapter(sourceStack.getOrCreateTag())
				set(value) {
					field!!.run {
						type = value?.type
						nbt = value?.nbt
					}
				}
			
			override fun convertFromItem(stack: ItemStack): IEntityFightData? {
				val eggItem = stack.item as SpawnEggItem
				val type = eggItem.getType(stack.tag).castLivingEntity() ?: return null
				val nbt = stack.tag ?: return null
				return IEntityFightData.ForTile(null, type, nbt)
			}
			
			override fun convertToItem(value: IEntityFightData?): ItemStack {
				val eggStack = value?.type?.let { ForgeSpawnEggItem.fromEntityType(it) }?.stack() ?: return ItemStack.EMPTY
				return eggStack.also {
					it.tag = value.nbt
				}
			}
			
			override fun acceptsItem(stack: ItemStack): Boolean {
				return stack.item is SpawnEggItem
			}
		},
		pSlot, pX, pY
	)
{

}

/**
 * A passthrough to the data of something arbitrary instead of a container.
 * Copied somewhat from EnderIO.
 */
open class SlotOptic<T : Any>(
	val itemRepresentable: IItemRepresentable<T>,
	pSlot: Int, pX: Int, pY: Int
) : Slot(EMPTY_INVENTORY, pSlot, pX, pY) {
	companion object {
		val EMPTY_INVENTORY = SimpleContainer(0)
	}
	
	var item: ItemStack
		@JvmName("getItemProperty") get() = getItem()
		set(value) = set(value)
	
	override fun getItem(): ItemStack {
		return itemRepresentable.asItem
	}
	
	override fun getMaxStackSize(): Int {
		return item.maxStackSize
	}
	
	override fun set(pStack: ItemStack) {
		itemRepresentable.asItem = pStack
		setChanged()
	}
	
	override fun mayPlace(pStack: ItemStack): Boolean {
		return itemRepresentable.acceptsItem(pStack)
	}
	
	override fun safeInsert(pStack: ItemStack, increment: Int): ItemStack {
		if (!pStack.isEmpty && mayPlace(pStack)) {
			itemRepresentable.asItem = pStack
		}
		return pStack
	}
	
	override fun setChanged() {}
}
